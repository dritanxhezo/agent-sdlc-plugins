{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/adapters/copilot.mjs\" session-context",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "create|edit|apply_patch|str_replace_editor",
        "command": "node \"${PLUGIN_ROOT}/hooks/adapters/copilot.mjs\" pre-write",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "create|edit|apply_patch|str_replace_editor",
        "command": "node \"${PLUGIN_ROOT}/hooks/adapters/copilot.mjs\" post-write",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "bash|powershell",
        "command": "node \"${PLUGIN_ROOT}/hooks/adapters/copilot.mjs\" task-sync",
        "timeoutSec": 20
      }
    ]
  }
}
