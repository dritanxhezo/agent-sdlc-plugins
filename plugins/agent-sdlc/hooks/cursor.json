{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "node ./hooks/adapters/cursor.mjs mcp-register",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "node ./hooks/adapters/cursor.mjs session-context"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./hooks/adapters/cursor.mjs pre-write",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node ./hooks/adapters/cursor.mjs post-write",
        "matcher": "Write",
        "timeout": 10
      },
      {
        "command": "node ./hooks/adapters/cursor.mjs task-sync",
        "matcher": "Shell",
        "timeout": 20
      }
    ]
  }
}
